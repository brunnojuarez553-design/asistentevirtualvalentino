PORT=3000
# Required outside loopback. Generate a random secret, minimum 32 characters.
DASHBOARD_TOKEN=
STORAGE=local
# Proyecto Supabase Valentino Motors
SUPABASE_URL=https://oficyvzpwpfjnajaqkrg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# For individual user access to Valentino panel (not a secret):
SUPABASE_PUBLISHABLE_KEY=
# Local tests may use token. Set 'supabase' when enabling the real panel.
AUTH_MODE=token
AI_ENABLED=false
# Optional IA (drafts only). Choose groq or openai. Do not turn on without keys.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Keep disabled until official permissions and explicit activation.
META_WEBHOOKS_ENABLED=false
META_APP_SECRET=
META_VERIFY_TOKEN=

# App Review manual, separado del canal de Valentino. Usar SOLO activos de prueba.
META_REVIEW_ENABLED=false
META_REVIEW_TEST_ASSETS_CONFIRMED=false
META_REVIEW_ACCESS_TOKEN=
# Copiar la versión vigente del panel de Meta; formato vNN.0
META_REVIEW_GRAPH_VERSION=
META_REVIEW_WABA_ID=
META_REVIEW_PHONE_NUMBER_ID=
# Número propio/autorizado registrado como destinatario de prueba, solo dígitos internacionales.
META_REVIEW_RECIPIENT=
# UUID de Supabase Auth de operadores owner/admin autorizados, separados por comas.
META_REVIEW_OPERATOR_IDS=
